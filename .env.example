# Database
DATABASE_URL=postgresql+asyncpg://contwatch:contwatch@localhost:5432/contwatch
POSTGRES_USER=contwatch
POSTGRES_PASSWORD=contwatch
POSTGRES_DB=contwatch

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DEBUG=true

# Default admin (used on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# Frontend (Vite — only needed for dev)
VITE_API_URL=http://localhost:8000

# Docker production
FRONTEND_DIST_PATH=./frontend/dist
