        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-router": "^1.163.3",
        "@xyflow/react": "^12.10.1",
        "axios": "^1.16.0",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
