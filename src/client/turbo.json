{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "stylelint": {
      "dependsOn": ["^stylelint"]
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_API_SERVER_HOST",
    "NEXT_PUBLIC_API_SERVER_PORT",
    "NEXT_PUBLIC_API_SERVER_PROTOCOL"
  ]
}
